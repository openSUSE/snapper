
# subvolume to snapshot
SUBVOLUME="/"

# filesystem type
FSTYPE="btrfs"


# btrfs qgroup for space aware cleanup algorithms
# WARNING: The use of Btrfs quota groups is discouraged. Enabling them may
# severely impact system performance. Use at your own risk!
QGROUP=""


# fraction or absolute size of the filesystems space the snapshots may use
# NOTE: This setting requires `QGROUP=` to be set.
SPACE_LIMIT="0.5"

# fraction or absolute size of the filesystems space that should be free
# NOTE: This setting is only effective if the `TIMELINE_LIMIT_*=` settings are
# ranges.
FREE_LIMIT="0.2"


# Whether snapshot numbers should be all-time unique. If set to yes, snapshot
# numbers are not reused even after snapshots are deleted.
UNIQUE_NUMBERS="yes"


# users and groups allowed to work with config
ALLOW_USERS=""
ALLOW_GROUPS=""

# sync users and groups from ALLOW_USERS and ALLOW_GROUPS to .snapshots
# directory
SYNC_ACL="no"


# start comparing pre- and post-snapshot in background after creating
# post-snapshot
BACKGROUND_COMPARISON="yes"


# run hourly number cleanup
NUMBER_CLEANUP="yes"

# limit for number cleanup
NUMBER_MIN_AGE="3600"
NUMBER_LIMIT="50"
NUMBER_LIMIT_IMPORTANT="10"


# create hourly snapshots
TIMELINE_CREATE="yes"

# cleanup hourly snapshots after some time
TIMELINE_CLEANUP="yes"

# limits for timeline cleanup
# NOTE: These values take precedence over `SPACE_LIMIT=` and `FREE_LIMIT=`. Even
# if those limits are exceeded, the number of snapshots specified here will be
# kept.
TIMELINE_MIN_AGE="3600"
TIMELINE_LIMIT_HOURLY="1-10"
TIMELINE_LIMIT_DAILY="1-10"
TIMELINE_LIMIT_WEEKLY="0"
TIMELINE_LIMIT_MONTHLY="1-10"
TIMELINE_LIMIT_QUARTERLY="0"
TIMELINE_LIMIT_YEARLY="1-10"


# cleanup empty pre-post-pairs
EMPTY_PRE_POST_CLEANUP="yes"

# limits for empty pre-post-pair cleanup
EMPTY_PRE_POST_MIN_AGE="3600"
